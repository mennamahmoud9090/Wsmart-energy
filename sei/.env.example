# Copy to .env.local. Only NON-SECRET values belong here: anything prefixed
# NEXT_PUBLIC_ is bundled into browser code. Never put Snowflake, MinIO, Kafka
# or Airflow credentials in this file; they belong in the backend's environment.

# "mock" = simulated data bundled in the front end (default). "api" = call the backend below.
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the backend API (only used when NEXT_PUBLIC_DATA_SOURCE=api).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional link to a Power BI workspace (plain URL, not an embed token).
# NEXT_PUBLIC_POWERBI_WORKSPACE_URL=

# Demo thresholds used to classify simulated readings (defaults shown).
# NEXT_PUBLIC_THRESHOLD_TRANSFORMER_WARNING_PCT=80
# NEXT_PUBLIC_THRESHOLD_TRANSFORMER_OVERLOAD_PCT=95
# NEXT_PUBLIC_NOMINAL_VOLTAGE_V=230
# NEXT_PUBLIC_VOLTAGE_TOLERANCE_PCT=10
